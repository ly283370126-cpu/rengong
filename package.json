{
  "name": "voice-orb-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:desktop": "concurrently -k -n server,web,electron -c cyan,magenta,yellow \"npm:dev:server\" \"npm:dev:web\" \"wait-on http://127.0.0.1:5173/api/health && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "build:desktop": "npm run build && electron-builder --win portable",
    "start": "tsx src/server/index.ts",
    "chrome:start": "tsx scripts/chrome-control.ts start",
    "chrome:stop": "tsx scripts/chrome-control.ts stop",
    "chrome:status": "tsx scripts/chrome-control.ts status",
    "chrome:goto": "tsx scripts/chrome-control.ts goto",
    "chrome:click": "tsx scripts/chrome-control.ts click",
    "chrome:type": "tsx scripts/chrome-control.ts type",
    "test:smoke": "tsx scripts/smoke.ts",
    "doctor": "tsx scripts/doctor.ts"
  },
  "build": {
    "appId": "local.voice-orb-assistant",
    "productName": "Voice Orb Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/server/**/*",
      "src/lib/**/*",
      "src/types/**/*",
      "package.json",
      ".env.example"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "three": "^0.181.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "undici": "^7.26.0",
    "vite": "^7.2.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "cross-env": "^10.1.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.10"
  }
}
